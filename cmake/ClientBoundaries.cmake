# Fail configuration for invalid library links, before any source is compiled.
set(REALM_BOUNDARY_TARGETS realm_support realm_platform realm_network realm_game realm_assets realm_ui realm_fixtures
    realm_render realm_platform_sdl realm_startup realm_application)
set(REALM_ALLOWED_realm_support realm_build_options)
set(REALM_ALLOWED_realm_platform realm_build_options)
set(REALM_ALLOWED_realm_network realm_build_options realm_support ws2_32)
set(REALM_ALLOWED_realm_game realm_build_options realm_network LibXml2::LibXml2 ZLIB::ZLIB nlohmann_json::nlohmann_json)
set(REALM_ALLOWED_realm_assets realm_build_options realm_game PNG::PNG Freetype::Freetype ZLIB::ZLIB nlohmann_json::nlohmann_json)
set(REALM_ALLOWED_realm_ui realm_build_options realm_assets)
set(REALM_ALLOWED_realm_fixtures realm_build_options realm_assets nlohmann_json::nlohmann_json)
set(REALM_ALLOWED_realm_render realm_build_options realm_assets OpenGL::GL GLEW::GLEW)
set(REALM_ALLOWED_realm_platform_sdl realm_build_options realm_platform SDL2::SDL2 OpenGL::GL GLEW::GLEW)
set(REALM_ALLOWED_realm_startup realm_build_options realm_ui realm_render)
set(REALM_ALLOWED_realm_application realm_build_options realm_startup realm_platform_sdl realm_fixtures)
set(boundary_manifest "${CMAKE_CURRENT_BINARY_DIR}/client-boundaries.tsv")
file(WRITE "${boundary_manifest}" "")
foreach(owner IN LISTS REALM_BOUNDARY_TARGETS)
    if(NOT TARGET ${owner})
        continue()
    endif()
    get_target_property(deps ${owner} LINK_LIBRARIES)
    get_target_property(public_deps ${owner} INTERFACE_LINK_LIBRARIES)
    get_target_property(sources ${owner} SOURCES)
    foreach(dep IN LISTS deps)
        if(NOT dep IN_LIST REALM_ALLOWED_${owner})
            message(FATAL_ERROR "Client boundary: ${owner} must not link ${dep}")
        endif()
    endforeach()
    file(APPEND "${boundary_manifest}" "${owner}\t${deps}\t${public_deps}\t${sources}\n")
endforeach()
if(BUILD_TESTING)
    add_test(NAME client_boundaries COMMAND Python3::Interpreter
        "${PROJECT_SOURCE_DIR}/tests/client_boundaries_tests.py" "${boundary_manifest}")
endif()
