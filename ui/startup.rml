<rml>
  <head>
    <title>startup screens</title>
    <link type="text/rcss" href="flash.rcss" />
    <link type="text/rcss" href="text.rcss" />
    <style>
      body { background-color: transparent; }
      #screen, #dialog, #skin {
        position: absolute;
        left: 0dp;
        top: 0dp;
        width: 100%;
        height: 100%;
      }
      #screen { z-index: 0; pointer-events: none; }
      #skin { display: none; z-index: 1; pointer-events: none; }
      #dialog { display: none; z-index: 2; pointer-events: auto; }
      native-image { display: block; }
      input { display: block; }
    </style>
  </head>
  <body>
    <div id="screen"></div>
    <native-image id="skin"></native-image>
    <div id="dialog"></div>
  </body>
</rml>
