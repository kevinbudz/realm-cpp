# Script mode (cmake -P): embeds the client's ui/*.rml and ui/*.rcss files into one generated translation unit that
# defines realm::ui::embedded_ui_file(). Inputs: -DOUTPUT=<generated .cpp> -DFILES=<'|'-separated paths>.
# Raw-string delimiter "realmui": a ui file must not contain )realmui".
string(REPLACE "|" ";" ui_files "${FILES}")
set(entries "")
foreach(path IN LISTS ui_files)
    get_filename_component(name "${path}" NAME)
    file(READ "${path}" content)
    if(content MATCHES "\\)realmui\"")
        message(FATAL_ERROR "${path} contains the raw-string terminator )realmui\"")
    endif()
    string(APPEND entries "        {\"${name}\",R\"realmui(${content})realmui\"},\n")
endforeach()
file(WRITE "${OUTPUT}" "// Generated by cmake/EmbedUiFiles.cmake from ui/*.rml and ui/*.rcss; do not edit.
#include \"realm/lib/ui/RmlHost.hpp\"
#include <functional>
#include <map>
namespace realm::ui {
const std::string* embedded_ui_file(std::string_view name) {
    static const std::map<std::string,std::string,std::less<>> files{
${entries}    };
    const auto found=files.find(name);
    return found==files.end() ? nullptr : &found->second;
}
}
")
