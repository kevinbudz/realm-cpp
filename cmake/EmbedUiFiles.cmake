# Script mode (cmake -P): embeds the files under -DROOT=<directory> named by -DFILES=<'|'-separated paths> into one
# generated translation unit that defines ${NAMESPACE}::${FUNCTION}(std::string_view), which returns a file's contents or
# null. Inputs: -DOUTPUT=<generated .cpp> -DROOT=<directory> -DFILES=<paths> -DHEADER=<header that declares FUNCTION>
# -DNAMESPACE=<C++ namespace> -DFUNCTION=<name>. A file is named by its path relative to ROOT ("flash.rcss" under
# ui/, "close_button.svg" under ui/deca/).
# Raw-string delimiter "realmui": a ui file must not contain )realmui". Contents are split into 8000-byte literals,
# well under MSVC's 16 KB limit per literal, and joined at first use.
string(REPLACE "|" ";" ui_files "${FILES}")
set(entries "")
foreach(path IN LISTS ui_files)
    file(RELATIVE_PATH name "${ROOT}" "${path}")
    file(READ "${path}" content)
    if(content MATCHES "\\)realmui\"")
        message(FATAL_ERROR "${path} contains the raw-string terminator )realmui\"")
    endif()
    string(LENGTH "${content}" length)
    set(pieces "")
    set(at 0)
    while(at LESS length)
        string(SUBSTRING "${content}" ${at} 8000 piece)
        string(APPEND pieces "R\"realmui(${piece})realmui\",")
        math(EXPR at "${at} + 8000")
    endwhile()
    string(APPEND entries "        {\"${name}\",join({${pieces}})},\n")
endforeach()
file(WRITE "${OUTPUT}" "// Generated by cmake/EmbedUiFiles.cmake from ${ROOT}; do not edit.
#include \"${HEADER}\"
#include <functional>
#include <initializer_list>
#include <map>
namespace ${NAMESPACE} {
namespace {
std::string join(std::initializer_list<std::string_view> pieces) {
    std::string text;
    for (const auto piece : pieces) {
        text += piece;
    }
    return text;
}
}
const std::string* ${FUNCTION}(std::string_view name) {
    static const std::map<std::string,std::string,std::less<>> files{
${entries}    };
    const auto found=files.find(name);
    return found==files.end() ? nullptr : &found->second;
}
}
")
