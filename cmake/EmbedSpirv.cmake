# Writes one C++ header that holds each SPIR-V file as a byte array (used by the Vulkan backend).
# Inputs: -DOUTPUT=<header> -DINPUTS=<a.spv;b.spv>. Each array is named after its file (dots become _)
# and has a matching <name>_size constant.
set(content "// Generated by cmake/EmbedSpirv.cmake from the Vulkan shaders. Do not edit.\n")
string(APPEND content "#pragma once\n#include <cstddef>\n\nnamespace realm::gfx::vk::spirv {\n")
foreach(file IN LISTS INPUTS)
    get_filename_component(base "${file}" NAME)
    string(REPLACE "." "_" name "${base}")
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "inline constexpr unsigned char ${name}[] = {${bytes}};\n")
    string(APPEND content "inline constexpr std::size_t ${name}_size = sizeof(${name});\n")
endforeach()
string(APPEND content "}  // namespace realm::gfx::vk::spirv\n")
file(WRITE "${OUTPUT}" "${content}")
