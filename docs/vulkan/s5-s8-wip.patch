+layout(location=1) in vec2 texcoord;
+layout(location=2) in float shade;
+layout(location=3) in vec4 spriteUV;
+layout(location=4) in float page;
+layout(location=5) in vec3 meshColor;
+layout(location=6) in float texturedFlag;
+layout(location=7) in float repeatFlag;
+
+layout(push_constant) uniform Push {
+    vec2 viewport;
+    vec2 groundOrigin;
+    vec2 groundX;
+    vec2 groundY;
+    float groundTime;
+    float pad0;
+    float pad1;
+    float pad2;
+    vec4 clipRect;
+    float clipCut;
+    int standalone;
+    int triangleList;
+    int groundSpace;
+    int clipped;
+} pc;
+
+layout(location=0) out vec2 uv;
+layout(location=1) out float lit;
+layout(location=2) flat out vec4 bounds;
+layout(location=3) flat out float layer;
+layout(location=4) flat out vec3 flatColor;
+layout(location=5) flat out float textured;
+layout(location=6) flat out float repeatTexture;
+
+void main() {
+    gl_Position = vec4(position.x / pc.viewport.x * 2.0 - 1.0,
+                       1.0 - position.y / pc.viewport.y * 2.0, 0.0, 1.0);
+    uv = texcoord; lit = shade;
+    bounds = spriteUV; layer = page; flatColor = meshColor;
+    textured = texturedFlag; repeatTexture = repeatFlag;
+}
diff --git a/src/stage3D/vk/shaders/model.frag b/src/stage3D/vk/shaders/model.frag
new file mode 100644
index 0000000..70e8534
--- /dev/null
+++ b/src/stage3D/vk/shaders/model.frag
@@ -0,0 +1,22 @@
+#version 450
+// The model fragment shader: nearest, repeated sprite times the face shade; or the flat
+// object colour.
+layout(location=0) in vec2 uv;
+layout(location=1) flat in float lit;
+layout(location=2) flat in vec4 bounds;
+layout(location=3) flat in float layer;
+layout(location=4) flat in vec3 flatColor;
+layout(location=5) flat in float textured;
+
+layout(set=0, binding=0) uniform sampler2DArray sprites;
+
+layout(location=0) out vec4 color;
+
+void main() {
+    if (textured < 0.5) { color = vec4(flatColor * lit, 1.0); return; }
+    vec2 page = vec2(textureSize(sprites, 0).xy);
+    vec2 size = bounds.zw * page;
+    vec2 coords = (bounds.xy * page + mod(floor(uv * size), size) + 0.5) / page;
+    vec4 texel = texture(sprites, vec3(coords, layer));
+    color = vec4(texel.rgb * lit, texel.a);
+}
diff --git a/src/stage3D/vk/shaders/model.vert b/src/stage3D/vk/shaders/model.vert
new file mode 100644
index 0000000..d7dd5a7
--- /dev/null
+++ b/src/stage3D/vk/shaders/model.vert
@@ -0,0 +1,51 @@
+#version 450
+// Instanced registered models (a port of the OpenGL model program). Vertices come from the model
+// geometry (binding 0); instances are quads (binding 1, 88 bytes). Same math as the GL program.
+layout(location=0) in vec3 position;
+layout(location=1) in vec3 normal;
+layout(location=2) in vec2 texcoord;
+layout(location=3) in float solid;
+layout(location=4) in vec2 origin;
+layout(location=5) in vec2 axisX;
+layout(location=6) in vec2 axisY;
+layout(location=7) in vec2 axisZ;
+layout(location=8) in vec4 spriteUV;
+layout(location=9) in float page;
+layout(location=10) in vec4 multiply;
+layout(location=11) in vec4 rotation;
+
+layout(push_constant) uniform Push {
+    vec2 viewport;
+    vec2 groundOrigin;
+    vec2 groundX;
+    vec2 groundY;
+    float groundTime;
+    float pad0;
+    float pad1;
+    float pad2;
+    vec4 clipRect;
+    float clipCut;
+    int standalone;
+    int triangleList;
+    int groundSpace;
+    int clipped;
+} pc;
+
+layout(location=0) out vec2 uv;
+layout(location=1) flat out float lit;
+layout(location=2) flat out vec4 bounds;
+layout(location=3) flat out float layer;
+layout(location=4) flat out vec3 flatColor;
+layout(location=5) flat out float textured;
+
+void main() {
+    vec2 pixel = origin + axisX * position.x + axisY * position.y + axisZ * position.z;
+    gl_Position = vec4(pixel.x / pc.viewport.x * 2.0 - 1.0,
+                       1.0 - pixel.y / pc.viewport.y * 2.0, 0.0, 1.0);
+    // Lighting3D.LIGHT_VECTOR = normalize(1, 3, 2), in world space after the object rotation.
+    vec3 n = vec3(normal.x * rotation.x - normal.y * rotation.y,
+                  normal.x * rotation.y + normal.y * rotation.x, normal.z);
+    lit = 0.75 + 0.25 * max(0.0, dot(n, vec3(1.0, 3.0, 2.0) / 3.7416573867739413));
+    uv = texcoord; bounds = spriteUV; layer = page; flatColor = multiply.rgb;
+    textured = solid < 0.5 && multiply.a > 0.5 ? 1.0 : 0.0;
+}
diff --git a/src/stage3D/vk/shaders/post.frag b/src/stage3D/vk/shaders/post.frag
new file mode 100644
index 0000000..a2e21b4
--- /dev/null
+++ b/src/stage3D/vk/shaders/post.frag
@@ -0,0 +1,60 @@
+#version 450
+// The post-effect fragment shader: the blur (a box of the blur width along axis), the blind grey,
+// and the vignette and sidebar overlays. A port of the OpenGL program; gl_FragCoord.xy is the
+// screen position
+// (the framebuffer's y runs down the screen).
+layout(set=2, binding=0) uniform sampler2D scene;
+
+layout(push_constant) uniform Post {
+    vec2 viewport;
+    vec2 pad;
+    vec4 rect;
+    vec2 region;
+    vec2 axis;
+    float blur;
+    int mode;
+    int blind;
+    float alpha;
+    float sidebar;
+} pc;
+
+layout(location=0) out vec4 color;
+
+vec4 fetch(ivec2 c) {
+    return (c.x < 0 || c.y < 0 || c.x >= int(pc.region.x) || c.y >= int(pc.region.y))
+               ? vec4(0)
+               : texelFetch(scene, c, 0);
+}
+
+void main() {
+    vec2 screen = gl_FragCoord.xy;
+    if (pc.mode == 1) {
+        // HurtOverlay: radial gradient ratios 0/155/255, alphas 0/0/.92, ellipse through the
+        // corners.
+        float r = length((screen - pc.region * 0.5) / (pc.region * 0.70710678));
+        float edge = clamp((r - 155.0 / 255.0) / (1.0 - 155.0 / 255.0), 0.0, 1.0) * 0.92;
+        color = vec4(1.0, 55.0 / 255.0, 0.0, edge * pc.alpha);
+        return;
+    }
+    if (pc.mode == 2) {
+        float t = clamp((screen.x - (pc.region.x - pc.sidebar)) / pc.sidebar, 0.0, 1.0);
+        color = vec4(0.0, 0.0, 0.0, t);
+        return;
+    }
+    ivec2 c = ivec2(screen);
+    vec4 sum;
+    if (pc.blur <= 0.0) {
+        sum = fetch(c);
+    } else {
+        float half_width = pc.blur * 0.5;
+        int n = min(int(ceil(half_width)), 160);
+        sum = vec4(0);
+        for (int i = -n; i <= n; ++i) {
+            sum += clamp(half_width - abs(float(i)) + 0.5, 0.0, 1.0) *
+                   fetch(c + ivec2(pc.axis) * i);
+        }
+        sum /= pc.blur;
+    }
+    vec3 rgb = pc.blind != 0 ? vec3(0.05 * (sum.r + sum.g + sum.b)) : sum.rgb;
+    color = vec4(rgb, 1.0);
+}
diff --git a/src/stage3D/vk/shaders/post.vert b/src/stage3D/vk/shaders/post.vert
new file mode 100644
index 0000000..d998ab4
--- /dev/null
+++ b/src/stage3D/vk/shaders/post.vert
@@ -0,0 +1,21 @@
+#version 450
+// The post passes: a full-screen rectangle (a strip of four corners) in pixels, as the GL program.
+layout(push_constant) uniform Post {
+    vec2 viewport;
+    vec2 pad;
+    vec4 rect;
+    vec2 region;
+    vec2 axis;
+    float blur;
+    int mode;
+    int blind;
+    float alpha;
+    float sidebar;
+} pc;
+
+void main() {
+    vec2 local = vec2(gl_VertexIndex & 1, (gl_VertexIndex >> 1) & 1);
+    vec2 pixel = pc.rect.xy + pc.rect.zw * local;
+    gl_Position = vec4(pixel.x / pc.viewport.x * 2.0 - 1.0,
+                       1.0 - pixel.y / pc.viewport.y * 2.0, 0.0, 1.0);
+}
