+                    elapsed(2, 3), elapsed(3, 4), models_ms, timer.models, timer.models_total});
+  }
+  timer.pending = false;
+}
+
+void VkRenderer::poll_gpu() {
+  for (std::uint32_t slot = 0; slot < timers_.size(); ++slot) {
+    poll_timer(slot);
+  }
